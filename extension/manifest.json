{
  "manifest_version": 3,
  "name": "MediaGrab - Send to Downloader",
  "version": "1.1.0",
  "description": "Detects videos and audio on web pages and sends them to the MediaGrab desktop app.",
  "permissions": [
    "contextMenus",
    "webRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MediaGrab",
    "default_popup": "popup.html",
    "default_icon": "icon128.png"
  },
  "icons": {
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}